{
  "name": "@whisper/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Whisper backend — auth, per-user data, and the transcription/cleanup proxy. Holds every secret.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "migrate": "tsx src/cli/migrate.ts",
    "create-user": "tsx src/cli/create-user.ts",
    "smoke": "tsx scripts/smoke.ts",
    "groq-check": "tsx scripts/groq-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@whisper/shared": "*",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "fastify": "5.11.3",
    "jsonwebtoken": "9.0.3",
    "openai": "7.4.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "8.21.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
