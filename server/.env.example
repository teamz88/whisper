# Whisper API — server/.env
# Copy to server/.env for local dev. On Coolify, set these in the service's
# Environment Variables instead. NEVER ship any of these to clients.

# --- Database -----------------------------------------------------------------
# Local dev (docker-compose): postgres://whisper:whisper@localhost:5432/whisper
# Coolify: the connection string of the attached Postgres service.
DATABASE_URL=postgres://whisper:whisper@localhost:5432/whisper

# Set to true when the Postgres host requires TLS you have no local CA for
# (typical for managed databases). Leave false for docker-compose.
DATABASE_SSL=false

# --- Transcription provider ----------------------------------------------------
# groq (default) or openai. Groq speaks the OpenAI wire protocol, so switching
# is just this flag + the matching key.
TRANSCRIPTION_PROVIDER=groq

GROQ_API_KEY=gsk_your_key_here
# Only needed when TRANSCRIPTION_PROVIDER=openai:
# OPENAI_API_KEY=sk-your_key_here

# Optional model overrides. Defaults (verified 2026-08-12):
#   groq:   whisper-large-v3-turbo / whisper-large-v3 / openai/gpt-oss-120b
#   openai: whisper-1 / whisper-1 / gpt-4o-mini
# The boot log warns when a configured model disappears from the provider's
# model list — check https://console.groq.com/docs/deprecations before releases.
# TRANSCRIBE_FAST_MODEL=whisper-large-v3-turbo
# TRANSCRIBE_ACCURATE_MODEL=whisper-large-v3
# CLEANUP_MODEL=openai/gpt-oss-120b

# --- Auth ----------------------------------------------------------------------
# Two DIFFERENT secrets, at least 32 chars each. Generate with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_me_too_and_make_it_different

# --- HTTP ----------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# The desktop app sends no Origin header, so '*' is fine for an internal API.
# Restrict it if a browser client ever appears.
CORS_ORIGIN=*

# Max accepted WAV upload. 24 MB ≈ 12 minutes of 16 kHz mono — inside every
# provider's 25 MB cap. Raise only if you move to Groq's dev tier url-upload.
# MAX_AUDIO_BYTES=25165824

# info in production, debug locally.
# LOG_LEVEL=info
