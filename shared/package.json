{
  "name": "@whisper/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wire contract shared by the Whisper API and the Whisper desktop app.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
