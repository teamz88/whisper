# Whisper self-hosting — selfhost/.env
# Easiest way to fill this in: run  ./setup.sh  (it asks two questions and
# generates the secrets for you). Or copy this file to .env and fill it in by
# hand: see docs/SELF-HOSTING.md, step "Create your settings file".
# NEVER share this file or commit it to git — it holds your keys.

# The web address people will use, WITHOUT https://  e.g. whisper.example.com
# Its DNS record must already point at this server.
DOMAIN=

# Free key from https://console.groq.com  (starts with gsk_)
GROQ_API_KEY=

# Three different random values. Generate each with:  openssl rand -hex 32
# (letters and numbers only — no spaces, quotes or symbols)
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Optional ----------------------------------------------------------------
# Use OpenAI instead of Groq:
# TRANSCRIPTION_PROVIDER=openai
# OPENAI_API_KEY=
