# Whisper desktop app — app/.env
# Copy to app/.env. Only needed when you BUILD the app yourself. If you just
# install a released Whisper, you set the server address inside the app instead
# (sign-in screen → Server). Installed copies contain no keys or credentials.

# The backend base URL, baked in at build time.
#   local dev:   http://localhost:8080
#   production:  your own server, e.g. https://whisper.example.com
VITE_API_URL=http://localhost:8080

# Only needed on the machine that publishes releases (`npm run release`): a
# GitHub token that can write to the repository named in app/electron-builder.yml
# (the `publish` section). Change owner/repo there if you publish your own builds.
# Never needed by people who only install the app.
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
