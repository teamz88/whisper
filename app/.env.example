# Whisper desktop app — app/.env
# Copy to app/.env. This is the client's ENTIRE configuration surface: one
# public URL, plus a release token used only on the machine that cuts releases.
# Installed copies of the app contain no keys and no database credentials.

# The backend base URL, baked in at build time.
#   local dev:  http://localhost:8080
#   production: your Coolify deployment, e.g. https://whisper.agent.omadligrouphq.com
VITE_API_URL=http://localhost:8080

# Only needed when running `npm run release` to upload installers to GitHub
# Releases (electron-updater feeds from there). A classic PAT with `repo` scope
# on the private repo. Never needed by teammates who just install the app.
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
